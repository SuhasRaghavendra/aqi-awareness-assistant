# ── API Keys for Real Indian Data Sources ─────────────────────────────────────
# Copy this file to .env and fill in your keys.
# Never commit .env to git.

# XKDR India Air Quality Database (AQI target labels)
# Sign up free at: https://airquality.xkdr.org
# Provides: CPCB CAAQM daily city-level AQI from 2009–present
XKDR_API_KEY=your_xkdr_api_key_here

# NASA FIRMS Fire Information System (crop/waste/fire burning events)
# Get free MAP_KEY instantly at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Provides: VIIRS 375m daily fire detections across all India, 2012–present
FIRMS_MAP_KEY=your_firms_map_key_here

# data.gov.in Open Government Data Platform (vehicle registration data)
# Register free at: https://data.gov.in → My Account → API Key
# Provides: State-wise vehicle registration by fuel type (MoRTH/Vahan data)
DATAGOV_API_KEY=your_datagov_api_key_here

# MLflow tracking (local SQLite by default — no key needed)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# DVC remote (local by default — no key needed for local storage)
# Uncomment and fill if using cloud remote:
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret

# ── Manual Download Instructions ──────────────────────────────────────────────
# Some data sources require manual download (no API available):
#
# 1. MOSPI IIP Manufacturing Index:
#    URL: https://esankhyiki.mospi.gov.in/
#    Download: "Index of Industrial Production" → Manufacturing → Monthly CSV
#    Save as: configs/iip_manufacturing.csv
#
# 2. CEA State Power Consumption:
#    URL: https://npp.gov.in → Reports → State Wise Generation Report (Monthly)
#    Save as: configs/cea_state_power.csv
#    Expected columns: state, year, month, energy_requirement_mu, energy_availability_mu
#
# 3. Vahan Vehicle Data (if data.gov.in API key unavailable):
#    URL: https://analytics.parivahan.gov.in/
#    OR:  configs/vehicle_state_reference.csv (pre-seeded with MoRTH RTYB data)
#    The pre-seeded file works out of the box for approximate vehicle features.
